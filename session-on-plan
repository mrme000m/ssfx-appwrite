const TOKEN_REFRESH_BUFFER_SEC = 5 * 60;

export interface RefreshResult {
  accessToken: string;
  accessTokenExpiresAt: number;
  refreshed: boolean;
}

/**
 * Refresh a grant's access token through the Durable Object lock.
 * This is called both from the internal refresh endpoint and from
 * the accounts endpoint when the token is near expiry.
 */
export async function refreshTokenWithLock(grantId: string, env: Env): Promise<RefreshResult> {
  const doId = env.REFRESH_LOCK.idFromName(grantId);
  const stub = env.REFRESH_LOCK.get(doId);

  const res = await stub.fetch(new Request("http://internal/refresh", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ grantId }),
  }));

  if (!res.ok) {
    const body = (await res.json()) as { error?: string };
    throw new Error(body.error ?? `Refresh lock returned ${res.status}`);
  }

  const result = (await res.json()) as RefreshResult;
  return result;
}

/**
 * POST /internal/ctrader/refresh
 * Internal endpoint for explicit refresh requests (e.g., from backend services).
 */
export async function handleInternalRefresh(request: Request, env: Env): Promise<Response> {
  let grantId: string;
  try {
    const body = (await request.json()) as { grantId?: string };
    grantId = body.grantId ?? "";
  } catch {
    return json({ error: "invalid_json" }, 400);
  }

  if (!grantId) {
    return json({ error: "missing_grant_id" }, 400);
  }

  const grant = await getGrantById(env.AUTH_DB, grantId);
  if (!grant) {
    return json({ error: "grant_not_found" }, 404);
  }

  if (grant.status !== "active") {
    return json({ error: "grant_inactive", status: grant.status }, 403);
  }

  const nowSec = Math.floor(Date.now() / 1000);
  if (grant.access_token_expires_at > nowSec + TOKEN_REFRESH_BUFFER_SEC) {
    const decrypted = await decryptGrantTokens(grant, env.TOKEN_ENCRYPTION_KEY);
    return json({
      access_token: decrypted.accessToken,
      expires_at: grant.access_token_expires_at,
      refreshed: false,
    }, 200);
  }

  try {
    const result = await refreshTokenWithLock(grantId, env);
    return json({
      access_token: result.accessToken,
      expires_at: result.accessTokenExpiresAt,
      refreshed: true,
    }, 200);
  } catch (err) {
    const message = err instanceof Error ? err.message : "refresh_failed";
    return json({ error: "refresh_failed", details: message }, 502);
  }
}

