/// <reference types="@cloudflare/workers-types" />

import { Env } from "../env";
import { getActiveGrantByUser } from "../db";

/**
 * GET /internal/grant/latest?user_id=<userId>
 *
 * Returns the latest active grant_id for a user. This is used by
 * init_mongo.py to auto-retrieve the grant_id after OAuth completes.
 *
 * Only returns the grant ID — never exposes tokens.
 */
export async function handleInternalGrantLatest(request: Request, env: Env): Promise<Response> {
  const url = new URL(request.url);
  const userId = url.searchParams.get("user_id");

  if (!userId || !/^[a-zA-Z0-9_-]{1,128}$/.test(userId)) {
    return json({ error: "missing_or_invalid_user_id" }, 400);
  }

  const grant = await getActiveGrantByUser(env.AUTH_DB, userId);
  if (!grant) {
    return json({ error: "grant_not_found" }, 404);
  }

  return json({
    grant_id: grant.id,
    user_id: grant.user_id,
    selected_account_id: grant.selected_account_id,
    status: grant.status,
    created_at: grant.created_at,
  }, 200);
}

function json(body: unknown, status: number): Response {
  return new Response(JSON.stringify(body), {
    status,
    headers: { "Content-Type": "application/json" },
  });
}

