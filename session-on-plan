### `init-scripts/resend-email.sh` (proposed content)

```bash
#!/usr/bin/env bash
# init-scripts/resend-email.sh — Configure Appwrite Messaging to send email via Resend.
# Idempotent: creates or updates the Resend provider.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
CONFIG_FILE="${SCRIPT_DIR}/config.yml"

# Source .env for APPWRITE_PROJECT_ID / APPWRITE_API_KEY / APPWRITE_ENDPOINT
if [[ -f "${PROJECT_ROOT}/.env" ]]; then
  set -a; source "${PROJECT_ROOT}/.env"; set +a
fi

# CLI arg overrides
API_KEY_ARG="${1:-}"
if [[ -n "${API_KEY_ARG}" ]]; then RESEND_API_KEY="${API_KEY_ARG}"; else
  if ! command -v yq &>/dev/null; then
    echo "Error: yq required (brew install yq) or pass key as arg." >&2; exit 1; fi
  if [[ ! -f "${CONFIG_FILE}" ]]; then
    echo "Error: ${CONFIG_FILE} not found." >&2; exit 1; fi
  RESEND_API_KEY="$(yq '.resend.api_key' "${CONFIG_FILE}")"
  FROM_EMAIL="$(yq '.resend.from_email' "${CONFIG_FILE}")"
  FROM_NAME="$(yq '.resend.from_name' "${CONFIG_FILE}")"
  REPLY_EMAIL="$(yq '.resend.reply_to_email' "${CONFIG_FILE}")"
  REPLY_NAME="$(yq '.resend.reply_to_name' "${CONFIG_FILE}")"
fi

for v in RESEND_API_KEY FROM_EMAIL FROM_NAME REPLY_EMAIL REPLY_NAME \
         APPWRITE_PROJECT_ID APPWRITE_API_KEY APPWRITE_ENDPOINT; do
  if [[ -z "${!v:-}" || "${!v}" == "null" ]]; then
    echo "Error: ${v} is missing." >&2; exit 1; fi
done

echo "[init] Configuring Appwrite Messaging Resend provider..."

node -e '
const { Client, Messaging } = require("node-appwrite");
const client = new Client()
  .setEndpoint(process.env.APPWRITE_ENDPOINT)
  .setProject(process.env.APPWRITE_PROJECT_ID)
  .setKey(process.env.APPWRITE_API_KEY);
const msg = new Messaging(client);
const PROVIDER_ID = "resend";
(async () => {
  try {
    await msg.getProvider({ providerId: PROVIDER_ID });
    await msg.updateResendProvider({
      providerId: PROVIDER_ID,
      name: "Resend",
      apiKey: process.env.RESEND_API_KEY,
      fromName: process.env.FROM_NAME,
      fromEmail: process.env.FROM_EMAIL,
      replyToName: process.env.REPLY_NAME,
      replyToEmail: process.env.REPLY_EMAIL,
      enabled: true,
    });
    console.log("[init] Resend provider updated and enabled.");
  } catch (e) {
    if (e.code === 404) {
      await msg.createResendProvider({
        providerId: PROVIDER_ID,
        name: "Resend",
        apiKey: process.env.RESEND_API_KEY,
        fromName: process.env.FROM_NAME,
        fromEmail: process.env.FROM_EMAIL,
        replyToName: process.env.REPLY_NAME,
        replyToEmail: process.env.REPLY_EMAIL,
        enabled: true,
      });
      console.log("[init] Resend provider created and enabled.");
    } else { console.error(e); process.exit(1); }
  }
})();
'

echo "[init] Done. Provider ID: resend (Messaging > Providers)."
echo "       From: ${FROM_NAME} <${FROM_EMAIL}>"
