            "$permissions": [
                "create(\"users\")",
                "read(\"users\")",
                "update(\"users\")",
                "delete(\"users\")"
            ],
            "databaseId": "ctrader_auth",
            "name": "Trade Configs",
            "enabled": true,
            "rowSecurity": true,
            "columns": [
                {
                    "key": "slave_user_id",
