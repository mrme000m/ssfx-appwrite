                    "required": true,
                    "size": 64
                },
                {
                    "key": "lot_size",
                    "type": "double",
                    "required": false,
                    "default": 0.01
                },
                {
                    "key": "lot_multiplier",
                    "type": "double",
                    "required": false,
                    "default": 1
