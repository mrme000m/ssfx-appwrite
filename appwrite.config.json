            "enabled": true,
            "rowSecurity": true,
            "columns": [
                {
                    "key": "appwrite_user_id",
                    "type": "varchar",
                    "required": true,
                    "size": 64
                },
                {
                    "key": "username",
                    "type": "varchar",
                    "required": false,
                    "size": 64
                },
                {
                    "key": "pin_hash",
                    "type": "varchar",
                    "required": false,
                    "size": 100
                },
                {
                    "key": "role",
                    "type": "varchar",
                    "required": true,
                    "size": 16
                },
                {
                    "key": "grant_id",
                    "type": "varchar",
                    "required": true,
                    "size": 64
                },
                {
                    "key": "access_token_enc",
                    "type": "text",
                    "required": false
                },
                {
                    "key": "refresh_token_enc",
                    "type": "mediumtext",
                    "required": false
                },
                {
                    "key": "access_token_expires_at",
                    "type": "datetime",
                    "required": false
                },
                {
                    "key": "ctrader_account_ids",
                    "type": "varchar",
                    "required": false,
                    "size": 256
                },
                {
                    "key": "selected_account_id",
                    "type": "varchar",
                    "required": false,
                    "size": 32
                },
                {
                    "key": "status",
                    "type": "varchar",
                    "required": true,
                    "size": 32
                },
                {
                    "key": "active",
                    "type": "boolean",
                    "required": true
                },
                {
                    "key": "email",
                    "type": "varchar",
                    "required": false,
                    "size": 128
                },
                {
                    "key": "last_heartbeat_at",
                    "type": "datetime",
                    "required": false
                }
            ],
            "indexes": [
                {
                    "key": "idx_appwrite_user_id",
                    "type": "key",
                    "attributes": [
                        "appwrite_user_id"
                    ]
                },
                {
                    "key": "idx_username",
                    "type": "unique",
                    "attributes": [
                        "username"
                    ]
                },
                {
                    "key": "idx_grant_id",
                    "type": "unique",
                    "attributes": [
                        "grant_id"
                    ]
                },
                {
                    "key": "idx_expires_at",
                    "type": "key",
                    "attributes": [
                        "access_token_expires_at"
                    ]
                },
                {
                    "key": "idx_status_active",
                    "type": "key",
                    "attributes": [
                        "status",
                        "active"
                    ]
                }
            ]
        },
        {
