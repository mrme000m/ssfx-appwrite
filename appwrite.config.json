{
    "projectId": "6a22a362002b9ae880bb",
    "projectName": "slwp",
    "endpoint": "https://sgp.cloud.appwrite.io/v1",
    "includes": {
        "functions": "appwrite/functions.json",
        "sites": "appwrite/sites.json"
    },
    "tablesDB": [
        {
            "$id": "ctrader_auth",
            "name": "cTrader Auth",
            "enabled": true
        }
    ],
    "tables": [
