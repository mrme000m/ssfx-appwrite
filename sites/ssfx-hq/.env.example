# SSFX HQ — environment variables consumed by build.js during Appwrite Site build.
# These are injected at build time; they are not bundled if left empty.

# Appwrite bootstrap (same as root .env)
ENDPOINT=https://sgp.cloud.appwrite.io/v1
PROJECTID=6a22a362002b9ae880bb

# Function custom domains
AUTHDOMAIN=https://auth.mrme.tech
PINDOMAIN=https://pin.mrme.tech

# Backend APIs
V2APIBASE=https://ssfx-api.mrme.tech
DATASERVICEBASE=https://dataservice.mrme.tech
AGENTHARNESSBASE=http://127.0.0.1:9003

# Appwrite table IDs
DATABASEID=ctrader_auth
MARKETDATABASEID=market_data

# Consolidated site URL
SITEURL=https://app.mrme.tech

# Admin API keys (required for master dashboard features)
V2ADMIN_KEY=
DATASERVICEAPI_KEY=
