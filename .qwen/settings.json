  "mcpServers": {
    "appwrite-api": {
      "command": "/Users/m/.local/bin/mcp-server-appwrite",
      "args": [],
      "env": {
        "APPWRITE_PROJECT_ID": "$APPWRITE_PROJECT_ID",
        "APPWRITE_API_KEY": "$APPWRITE_API_KEY",
        "APPWRITE_ENDPOINT": "$APPWRITE_ENDPOINT"
      },
      "timeout": 60000,
      "description": "Appwrite API MCP server for project slwp (sgp)"
    },
    "appwrite-docs": {
      "httpUrl": "https://mcp-for-docs.appwrite.io",
      "timeout": 30000,
      "description": "Appwrite Docs MCP server"
    }
  },
  "$version": 4,
  "permissions": {
    "allow": [
      "mcp__context-mode__ctx_batch_execute",
      "mcp__appwrite-api__appwrite_search_tools",
      "mcp__appwrite-docs__listFeatures",
      "mcp__appwrite-docs__search",
      "mcp__appwrite-docs__getDocsPage",
      "mcp__appwrite-docs__getFeatureExamples",
      "mcp__appwrite-docs__getTableOfContents",
      "mcp__context-mode__ctx_execute_file",
      "mcp__appwrite-api__appwrite_search_docs",
      "mcp__context-mode__ctx_execute",
      "mcp__appwrite-api__appwrite_call_tool"
    ]
  }
