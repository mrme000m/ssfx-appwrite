# PPLX Agent configuration (development fallback only).
# Canonical config should be persisted to Appwrite service_config (config_key=pplx_agent).
# Secrets (Perplexity cookies, TradingView session) are loaded from Bitwarden.

# Perplexity
PPLX_BW_ITEM_NAME=perplexity.ai
PPLX_MODE=pro
PPLX_MODEL=GPT-5.5
PPLX_THINKING=true
PPLX_TIMEOUT=120

# Gold Market Space
GOLD_MARKET_SPACE_NAME=Gold Market Intelligence
# GOLD_MARKET_SPACE_UUID=         # populated by ./dev.sh pplx-agent setup

# TradingView (free tier; only needed for private scripts)
TV_USER=
TV_SESSION=
TV_SIGNATURE=

# Analysis target
ANALYSIS_SYMBOL=XAUUSD
ANALYSIS_TIMEFRAMES=1,5,15,60,240,D,W,M

# Upstream services
DATA_SERVICE_BASE_URL=http://localhost:9002
DATA_SERVICE_API_KEY=
AGENT_HARNESS_URL=http://localhost:9003

# API server
API_HOST=0.0.0.0
API_PORT=9004

# Output
REPORT_OUTPUT_DIR=./reports
CACHE_DIR=./.cache
LOG_DIR=./logs
LOG_LEVEL=INFO
REPORT_RETENTION_DAYS=90

# Feature flags
PPLX_ENABLE_MACRO=true
PPLX_ENABLE_TECHNICAL=true
PPLX_ENABLE_FUNDAMENTAL=true
PPLX_ENABLE_SPACE_SYNC=true
