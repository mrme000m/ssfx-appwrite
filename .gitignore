# Environment variables
.env
.env.local
.env.*.local

# Runtime secrets (example templates are committed)
remote-services/config/v2.env
remote-services/config/*.env
!remote-services/config/*.env.example

# Init scripts secrets
init-scripts/config.yml

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# PPLX Agent local runtime output
pplx-agent/.cache/
pplx-agent/logs/
pplx-agent/reports/

# Node modules
node_modules/

# Generated per-function shared copies (canonical source is functions/_shared/)
functions/*/src/_shared/

# Appwrite build caches
.tmp/

# Firecrawl local cache
.firecrawl

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# Agent skill symlinks (canonical source is ~/.claude/plugins/appwrite-ctrader/skills)
.agents/skills/
.qwen/skills/

# Backup files
*.orig
