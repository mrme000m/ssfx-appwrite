# ============================================================
# ssfx-server — Telegram webhook + cTrader follower admin
# ctrader — unified cTrader service (WS hub + trade exec)
# ============================================================
# Shared by both services. Mount at /app/config/v2.env in the container.

# Telegram bot that is admin of the destination channel (ssfcp00)
TELEGRAM_BOT_TOKEN=

# Telegram webhook verification (required unless WEBHOOK_HOST=polling).
# Telegram sends this in the X-Telegram-Bot-Api-Secret-Token header.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Source channel where the original signals are published
SOURCE_CHAT_ID=-1001661400724

# LLM parser (OpenRouter or any OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Mistral AI native API (overrides generic LLM_API_KEY for the intent agent)
MISTRALAI_API_KEY=
MISTRALAI_BASE_URL=https://api.mistral.ai/v1

# Webhook settings (ssfx-server)
# New hostname: https://api.mrme.tech (legacy https://ssfx-api.mrme.tech still works)
WEBHOOK_HOST=https://api.mrme.tech
WEBHOOK_PATH=/webhook
SSFX_SERVER_PORT=8000

# Logging
LOG_LEVEL=INFO

# Appwrite (required for account storage and config)
# Database: slwp_platform (legacy name: ctrader_auth)
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
# Legacy alias — will be removed after full migration
CTRADER_AUTH_DATABASE_ID=
# Tables (new names — legacy aliases are still accepted during cutover)
APPWRITE_ACCOUNTS_TABLE=signal_slaves
APPWRITE_USERS_TABLE=users
APPWRITE_TRADE_SETTINGS_TABLE=trade_settings
APPWRITE_CTRADER_ACCOUNTS_TABLE=ctrader_accounts
APPWRITE_ACCOUNT_STATE_TABLE=account_state_history
APPWRITE_SIGNAL_BROADCASTS_TABLE=signal_broadcasts
APPWRITE_PRESETS_TABLE=ssfx_presets
APPWRITE_EXECUTIONS_TABLE=ssfx_executions
APPWRITE_RISK_STATE_TABLE=ssfx_risk_state
APPWRITE_TRADING_EVENTS_TABLE=trading_events

# DataService / Market data API (read-only public API)
# New hostname: https://market.mrme.tech (legacy https://dataservice.mrme.tech still works)
DATA_SERVICE_URL=http://host.docker.internal:9002
MARKET_API_URL=http://host.docker.internal:9002
DATA_SERVICE_API_KEY=
MARKET_API_KEY=

# AI Agent Harness (XAUUSD decision layer)
# New hostname: https://ai.mrme.tech (legacy https://agent.mrme.tech still works)
AGENT_HARNESS_HOST=0.0.0.0
AGENT_HARNESS_PORT=9003
AGENT_HARNESS_URL=http://host.docker.internal:9003
AI_BASE_URL=http://host.docker.internal:9003
AGENT_INTENT_ENABLED=true
AGENT_ENTRY_ENABLED=true
AGENT_LIFECYCLE_ENABLED=true
AGENT_AUTONOMY_ENABLED=false
AGENT_MIN_ENTRY_CONFIDENCE=0.65
AGENT_MIN_LIMIT_CONFIDENCE=0.60

# Symbols that are allowed to use AI agents (entry decision + lifecycle planning).
# Comma-separated. Default is XAUUSD only; add BTCUSD for weekend crypto testing.
AGENT_ENABLED_SYMBOLS=XAUUSD

# Autonomous XAUUSD signal generation from gold-quant engine + entry agent.
# Set GOLD_QUANT_SIGNAL_ENABLED=true to enable the loop.
GOLD_QUANT_SIGNAL_ENABLED=false
GOLD_QUANT_SIGNAL_INTERVAL_SEC=60
GOLD_QUANT_MIN_CONFIDENCE=0.75
GOLD_QUANT_AGENT_MIN_CONFIDENCE=0.65
AGENT_MODEL_MISTRAL=mistralai/mistral-small-3.2-24b-instruct
AGENT_MODEL_HERMES=nousresearch/hermes-3-llama-3.1-405b
AGENT_MODEL_KIMI=moonshotai/kimi-k2.7-code
# Optional local vLLM / llama.cpp endpoints for hybrid hosting
AGENT_LOCAL_BASE_URL_MISTRAL=
AGENT_LOCAL_BASE_URL_HERMES=
AGENT_LOCAL_BASE_URL_KIMI=

# CORS origins for the agent harness (browser clients only).
AGENT_HARNESS_CORS_ORIGINS=https://app.mrme.tech,https://command.mrme.tech,https://admin.mrme.tech,http://localhost:3000,http://localhost:8001

# cTrader OAuth broker (Appwrite ctrader-internal function — REQUIRED)
CTRADER_AUTH_BROKER_URL=
INTERNAL_API_KEY=

# cTrader Open API credentials
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# CORS / admin site origin (the browser SPA that calls the ssfx-server admin API)
ADMIN_SITE_ORIGIN=https://app.mrme.tech

# Admin API key (required). Protects /api/* endpoints including /api/signals/inject.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Signal persistence: "appwrite" (default), "sqlite", or "noop".
# Appwrite TablesDB is the source of truth; SQLite is the automatic local fallback when
# Appwrite is unreachable or misconfigured. Set SIGNAL_STORE_FALLBACK_SQLITE=false to
# disable fallback. "noop" keeps everything in memory and should only be used for tests.
SIGNAL_STORE_BACKEND=appwrite
APPWRITE_SIGNAL_DATABASE_ID=market_data
APPWRITE_RAW_MESSAGES_TABLE=raw_messages
APPWRITE_PARSED_SIGNALS_TABLE=parsed_signals
APPWRITE_SIGNAL_TRADES_TABLE=signal_trades
SIGNAL_STORE_SQLITE_PATH=/app/data/signals.db
SIGNAL_STORE_FALLBACK_SQLITE=true

# Direct HTTP push from the upstream alwaydata service.
# Must match SIGNAL_WEBHOOK_SECRET in the upstream .env when SIGNAL_WEBHOOK_URL is set.
SIGNAL_WEBHOOK_SECRET=

# Signal experience system (incremental quality scoring)
SIGNAL_EXPERIENCE_ENABLED=true
SIGNAL_EXPERIENCE_DATABASE_ID=market_data
SIGNAL_EXPERIENCE_BLOCK_THRESHOLD=0.50
SIGNAL_EXPERIENCE_REDUCE_THRESHOLD=0.75

# ------------ ctrader service specific ------------
CTRADER_HOST=0.0.0.0
CTRADER_PORT=9300
CTRADER_LOG_LEVEL=INFO
SLAVE_API_KEY=
DATA_POLL_INTERVAL_MS=250
DEFAULT_POSITION_TIMEOUT_MINUTES=5.0
TOKEN_REFRESH_BUFFER_SECONDS=300.0

# ------------ Account Hub (persistent cTrader connections) ------------
ACCOUNT_HUB_PORT=9301
ACCOUNT_HUB_ENABLED=true
ACCOUNT_HUB_POLL_INTERVAL=30.0
ACCOUNT_HUB_RECONNECT_BASE=5.0
ACCOUNT_HUB_RECONNECT_MAX=60.0
# Table names (new → legacy aliases still accepted)
USERS_TABLE=users
SLAVE_ACCOUNTS_TABLE=users
CTRADER_AUTH_DATABASE_ID=ctrader_auth
APPWRITE_DATABASE_ID=ctrader_auth
