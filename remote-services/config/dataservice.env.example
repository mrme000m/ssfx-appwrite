# MongoDB
MARKET_DATA_MONGODB_URI=mongodb://host.docker.internal:27017
MARKET_DATA_MONGODB_DATABASE=market_data
MARKET_DATA_MONGODB_MAX_POOL_SIZE=50

# Appwrite (cloud-hosted database backend)
MARKET_DATA_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
MARKET_DATA_APPWRITE_PROJECT_ID=
MARKET_DATA_APPWRITE_DATABASE_ID=market_data
MARKET_DATA_APPWRITE_API_KEY=

# Appwrite Config Sync
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=market_data
APPWRITE_CONFIG_TABLE_ID=service_config
APPWRITE_CONFIG_ROW_ID=service_config

# Database backend (influxdb | sqlite | appwrite | mongodb)
MARKET_DATA_DB_BACKEND=influxdb

# InfluxDB Cloud Serverless (primary time-series store)
MARKET_DATA_INFLUXDB_HOST=https://us-east-1-1.aws.cloud2.influxdata.com
MARKET_DATA_INFLUXDB_TOKEN=
MARKET_DATA_INFLUXDB_ORG=
MARKET_DATA_INFLUXDB_DATABASE=market_data
MARKET_DATA_INFLUXDB_RETENTION_DAYS=30
MARKET_DATA_INFLUXDB_WRITE_BATCH_SIZE=100
MARKET_DATA_INFLUXDB_MAX_WRITE_BYTES_PER_SEC=10240
MARKET_DATA_INFLUXDB_WRITE_BURST_BYTES=17408
MARKET_DATA_INFLUXDB_MAX_READ_BYTES_PER_SEC=819200
MARKET_DATA_INFLUXDB_SIDECAR_PATH=/app/logs/influxdb_metadata.db

# cTrader Auth Broker / Appwrite ctrader-internal Function
CTRADER_AUTH_BROKER_URL=https://internal.mrme.tech
CTRADER_AUTH_GRANT_ID=
INTERNAL_API_KEY=

# cTrader Open API credentials
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_ID=
CTRADER_HOST_TYPE=demo
CTRADER_TRANSPORT_TYPE=tcp

# Appwrite-native cTrader auth for the data service
CTRADER_USE_APPWRITE_AUTH=false
CTRADER_APPWRITE_USERNAME=
CTRADER_AUTH_DATABASE_ID=ctrader_auth
SLAVE_ACCOUNTS_TABLE=slave_accounts
ACCOUNT_EVENTS_TABLE=account_events

# Service
MARKET_DATA_SERVER_NAME=market-data-service
MARKET_DATA_SERVER_HOST=0.0.0.0
MARKET_DATA_SERVER_PORT=9001
DS_CONTROL_PORT=9000
MARKET_DATA_API_PORT=9002
MARKET_DATA_LOG_LEVEL=INFO
MARKET_DATA_TICK_BUFFER_SIZE=10000
MARKET_DATA_BAR_BUFFER_SIZE=5000
MARKET_DATA_DEPTH_BUFFER_SIZE=1000
MARKET_DATA_TICK_FLUSH_BATCH_SIZE=100
MARKET_DATA_BAR_FLUSH_BATCH_SIZE=20
MARKET_DATA_FLUSH_INTERVAL_SECONDS=5.0

# Data Quality
MARKET_DATA_STALE_THRESHOLD_SECONDS=30
MARKET_DATA_GAP_FILL_ENABLED=true
MARKET_DATA_MAX_GAP_FILL_BARS=1000
