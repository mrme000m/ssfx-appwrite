# Dataservice workspace YAML config.
# Copy to config/dataservice-config.yml and fill in credentials.
# Precedence (highest first):
#   1. Explicit environment variables
#   2. .env file (config/dataservice.env)
#   3. This YAML file

service:
  name: market-data-service
  host: 0.0.0.0
  port: 9001
  ds_control_port: 9000
  api_port: 9002
  log_level: INFO
  tick_buffer_size: 10000
  bar_buffer_size: 5000
  depth_buffer_size: 1000
  tick_flush_batch_size: 100
  bar_flush_batch_size: 20
  flush_interval_seconds: 5.0
  reconnect_delay: 5.0
  max_reconnect_delay: 60.0

database:
  backend: influxdb
  sqlite_path: /app/logs/market_data.db
  influxdb_host: https://us-east-1-1.aws.cloud2.influxdata.com
  influxdb_database: market_data
  influxdb_retention_days: 30

ctrader:
  host_type: demo
  transport_type: tcp
  # Set use_appwrite_auth: true to authenticate through the Appwrite auth layer.
  # When enabled, the service discovers active slave accounts from Appwrite and
  # opens one environment transport (live or demo) via ctrader-internal.
  use_appwrite_auth: false
  # broker_url is the ctrader-internal Appwrite Function domain.
  # broker_url: https://internal.mrme.tech
  # internal_api_key:
  # client_id:
  # client_secret:
  # Optional: prefer a specific slave username for market-data subscriptions.
  # appwrite_username: mrme000m0
  # auth_database_id: ctrader_auth
  # slave_accounts_table: slave_accounts
  # account_events_table: account_events
  # Legacy single-account mode:
  # account_id:
