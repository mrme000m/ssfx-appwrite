# Data service feed source
DATA_SERVICE_URL=https://dataservice.mrme.tech
DATA_SERVICE_API_KEY=

# Service auth keys
SLAVE_API_KEY=
ADMIN_API_KEY=
CTRADER_DATA_API_SECRET=

# Service binding
CTRADER_HOST=127.0.0.1
CTRADER_PORT=9300
CTRADER_LOG_LEVEL=INFO

# Defaults
DATA_POLL_INTERVAL_MS=250
DEFAULT_POSITION_TIMEOUT_MINUTES=5
TOKEN_REFRESH_BUFFER_SECONDS=300
