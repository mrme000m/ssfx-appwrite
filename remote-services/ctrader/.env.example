# Appwrite bootstrap credentials
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a22a362002b9ae880bb
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=ctrader_auth

# Trading event tables
APPWRITE_EXECUTIONS_TABLE=ssfx_executions
APPWRITE_EVENTS_TABLE=ctrader_trading_events
APPWRITE_ACCOUNTS_TABLE=ssfx_accounts

# cTrader auth broker (ctrader-internal function domain)
CTRADER_AUTH_BROKER_URL=https://internal.mrme.tech
INTERNAL_API_KEY=

# cTrader OAuth app credentials (same app used for slave OAuth)
CTRADER_CLIENT_ID=
